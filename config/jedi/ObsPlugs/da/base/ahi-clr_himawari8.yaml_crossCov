- obs space:
    <<: *ObsSpace
    name: ahi-clr_himawari8
    _obsdatain: &ObsDataIn
      engine:
        type: H5File
        obsfile: {{InDBDir}}/ahi-clr_himawari8_obs_{{thisValidDate}}.h5
    _obsdataout: &ObsDataOut
      engine:
        type: H5File
        obsfile: {{OutDBDir}}{{MemberDir}}/{{obsPrefix}}_ahi-clr_himawari8{{ObsOutSuffix}}.h5
    obsdatain: *{{ObsDataIn}}
    {{ObsDataOut}}
    simulated variables: [brightnessTemperature]
    channels: &clrahi_channels 8-10
  obs error:
    covariance model: cross variable covariances
    input file: /glade/work/ivette/pandac/scripts/obsCov/8-10_CSR/Rcov.GEOIR_csr.nc
  <<: *horizObsLoc
  obs operator:
    <<: *clearCRTMObsOperator
    obs options:
      <<: *CRTMObsOptions
      Sensor_ID: ahi_himawari8
  get values:
    <<: *GetValues
